const { EmbedBuilder } = require('discord.js');
const pool = require('../db');
const { getRankFromRiotId } = require('../utils/lolApi');

const rankValue = {
  IRON: 1,
  BRONZE: 2,
  SILVER: 3,
  GOLD: 4,
  PLATINUM: 5,
  EMERALD: 6,
  DIAMOND: 7,
  MASTER: 8,
  GRANDMASTER: 9,
  CHALLENGER: 10
};

module.exports = {
  data: {
    name: 'lol-team'
  },

  async execute(interaction) {

    await interaction.deferReply();

    // =========================
    // ① ユーザー取得
    // =========================
    const selectedUsers = [];

    for (let i = 1; i <= 10; i++) {
      const user = interaction.options.getUser(`user${i}`);
      if (user) selectedUsers.push(user);
    }

    // =========================
    // ② バリデーション
    // =========================
    if (selectedUsers.length < 2) {
      return interaction.reply({ content: '2人以上指定してね', ephemeral: true });
    }

    if (selectedUsers.length % 2 !== 0) {
      return interaction.reply({ content: '人数は偶数にしてね', ephemeral: true });
    }

    const unique = new Set(selectedUsers.map(u => u.id));
    if (unique.size !== selectedUsers.length) {
      return interaction.reply({ content: '同じ人が含まれてるよ', ephemeral: true });
    }

    await interaction.deferReply();

    // =========================
    // ③ DB取得
    // =========================
    const players = [];

    for (const user of selectedUsers) {
      const result = await pool.query(
        `SELECT * FROM lol_users WHERE guild_id = $1 AND user_id = $2`,
        [interaction.guild.id, user.id]
      );

      const userData = result.rows[0];

      if (!userData) {
        return interaction.editReply(`❌ <@${user.id}> は未登録`);
      }

      // =========================
      // ④ ランク取得
      // =========================
      const rankData = await getRankFromRiotId(userData.lol_id);

      let score = 0;

      if (typeof rankData === 'object') {
        const base = rankValue[rankData.tier] || 0;
        score = base * 100 + (rankData.lp || 0);
      }

      players.push({
        id: user.id,
        name: userData.lol_id,
        score
      });
    }

    // =========================
    // ⑤ チーム分け（ガチバランス）
    // =========================
    players.sort((a, b) => b.score - a.score);

    let teamA = [];
    let teamB = [];

    let sumA = 0;
    let sumB = 0;

    for (const p of players) {
      if (sumA <= sumB) {
        teamA.push(p);
        sumA += p.score;
      } else {
        teamB.push(p);
        sumB += p.score;
      }
    }

    // =========================
    // ⑥ 表示
    // =========================
    const format = (team) =>
      team.map(p => `<@${p.id}> (${p.score})`).join('\n');

    const embed = new EmbedBuilder()
      .setTitle('⚔️ チーム分け（バランス）')
      .addFields(
        { name: `🟥 Team A (${sumA})`, value: format(teamA), inline: true },
        { name: `🟦 Team B (${sumB})`, value: format(teamB), inline: true }
      )
      .setColor(0x00AE86);

    await interaction.editReply({ embeds: [embed] });
  }
};